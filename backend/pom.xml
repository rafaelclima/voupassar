<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- TASK 3.1 — Bootstrap Spring Boot.
       Spring Boot 4.1.0 = latest stable (Maven Central, 2026-06-10).
       Java 21 (LTS): seguro para VPS 2GB; compila e roda no JDK 27 local
       via maven.compiler.release=21. Ver backend/README.md. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>br.com.voupassar</groupId>
  <artifactId>voupassar-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>voupassar-backend</name>
  <description>VouPassar — API REST (bootstrap TASK 3.1)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- REST -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation (AGENTS.md §15: validação de entrada) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Segurança base (secure-by-default; JWT completo na TASK 3.5) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Persistência (valida integração com o PostgreSQL da TASK 2.2) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Flyway (Boot 4: auto-config vive no starter; sem ele o migrate
         silenciosamente não executa — ver TASK 3.1) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Observabilidade -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Testes -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4: AutoConfigureMockMvc/@WebMvcTest vivem neste starter -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4: liga @WithMockUser ao MockMvc (SecurityMockMvcAutoConfiguration) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Banco em memória só para testes de slice (health/exception);
         integração real com Postgres via Docker fica para TASK 3.2+. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>

    <!-- Reuso das migrations canônicas em database/migrations (TASK 2.2).
         Copia para classpath:db/migration no build — sem duplicar SQL.
         Fonte de verdade continua sendo database/migrations/*.sql. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>../database/migrations</directory>
        <targetPath>db/migration</targetPath>
        <includes>
          <include>*.sql</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
