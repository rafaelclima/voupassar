# Cópia local: cp .env.example .env (nunca commitar o .env com segredos reais)
POSTGRES_DB=voupassar
POSTGRES_USER=voupassar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Backend (TASK 3.1) — placeholders, nunca segredos reais
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:8080
JAVA_OPTS=-Xms256m -Xmx512m

# Auth (TASK 3.5) — placeholders, nunca segredos reais.
# JWT_SECRET de produção: 32+ bytes aleatórios (ex.: openssl rand -base64 32).
# O default do application.yml é SÓ para dev local.
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_DEV_ONLY
JWT_ISSUER=voupassar
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
RESET_TTL_MINUTES=60
BCRYPT_STRENGTH=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
